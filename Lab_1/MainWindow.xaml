<Window x:Class="Lab_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Lab_1.ViewModels"
        Title="Управление финансовой системой" Height="600" Width="900" WindowStartupLocation="CenterScreen">

    <!--подключение mainviewmodel к окну-->
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>

                <DataTemplate DataType="{x:Type viewmodels:AuthViewModel}">
                    <StackPanel Width="250" VerticalAlignment="Center">
                        <TextBlock Text="Авторизация" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="Логин:"/>
                        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Пароль:"/>
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Button Content="Войти" Command="{Binding LoginCommand}" Padding="5" Margin="0,0,0,5"/>
                        <Button Content="Регистрация клиента" Command="{Binding RegisterClientCommand}" Padding="5"/>
                    </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="{x:Type viewmodels:AdminViewModel}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Панель Администратора (Логи системы)" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Button Content="Выйти" Command="{Binding LogoutCommand}" HorizontalAlignment="Right" Width="80" Padding="5"/>
                        </Grid>

                        <!--таблица с логами-->
                        <ListView Grid.Row="1" ItemsSource="{Binding ActionLogs}" SelectedItem="{Binding SelectedAction}" Margin="0,0,0,10">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Время" DisplayMemberBinding="{Binding Timestamp}" Width="140"/>
                                    <GridViewColumn Header="Пользователь" DisplayMemberBinding="{Binding InitiatorLogin}" Width="100"/>
                                    <GridViewColumn Header="Описание действия" DisplayMemberBinding="{Binding LogMessage}" Width="300"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Button Grid.Row="2" Content="Отменить выбранное действие" Command="{Binding UndoCommand}" Height="35" Width="250" HorizontalAlignment="Center" Background="#FFDCA8A8" FontWeight="Bold"/>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type viewmodels:ManagerViewModel}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Панель Менеджера" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Смоделировать 1 месяц" Command="{Binding SkipMonthCommand}" Margin="0,0,10,0" Padding="5" Background="#FFB2EBB2"/>
                                <Button Content="Выйти" Command="{Binding LogoutCommand}" Width="80" Padding="5"/>
                            </StackPanel>
                        </Grid>

                        <TabControl Grid.Row="1">

                            <TabItem Header="Одобрение клиентов">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ListView Grid.Row="0" ItemsSource="{Binding UnapprovedClients}" SelectedItem="{Binding SelectedClient}" Margin="0,0,0,10">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="250"/>
                                                <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding Login}" Width="150"/>
                                                <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding IsApproved}" Width="100"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Одобрить" Command="{Binding ApproveClientCommand}" Height="30" Width="150" Background="#FFB2EBB2" Margin="0,0,10,0"/>
                                        <Button Content="Отклонить" Command="{Binding RejectClientCommand}" Height="30" Width="150" Background="#FFFFC5C5"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Все счета">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ListView Grid.Row="0" ItemsSource="{Binding AllAccounts}" SelectedItem="{Binding SelectedAccount}" Margin="0,0,0,10">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="ID Счета" Width="280">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Баланс" DisplayMemberBinding="{Binding Balance, StringFormat=\{0:F2\}}" Width="100"/>
                                                <GridViewColumn Header="Заблокирован?" DisplayMemberBinding="{Binding IsBlocked}" Width="100"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <Button Grid.Row="1" Content="Заблокировать / Разблокировать" Command="{Binding ToggleBlockCommand}" Height="30" Width="220" Background="#FFFFC5C5"/>
                                </Grid>
                            </TabItem>

                            <TabItem Header="История переводов">
                                <ListView ItemsSource="{Binding AllTransactions}" Margin="5">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Timestamp}" Width="140"/>
                                            <GridViewColumn Header="Откуда" Width="220">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding FromAccountId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Куда" Width="220">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding ToAccountId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding Amount, StringFormat=\{0:F2\}}" Width="80"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>

                            <TabItem Header="Предприятия">
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Список предприятий -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Компании (Зарплатные проекты):" FontWeight="Bold"/>
                                        <ListView ItemsSource="{Binding AllCompanies}" SelectedItem="{Binding SelectedCompany}" Height="150" Margin="0,5,0,10">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                                    <GridViewColumn Header="Размер ЗП" DisplayMemberBinding="{Binding SalaryAmount, StringFormat=\{0:F2\}}" Width="100"/>
                                                    <GridViewColumn Header="Заявка?" DisplayMemberBinding="{Binding IsSalaryProjectRequested}" Width="70"/>
                                                    <GridViewColumn Header="Одобрен?" DisplayMemberBinding="{Binding IsSalaryProjectApproved}" Width="70"/>
                                                    <GridViewColumn Header="ID" Width="150">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <Button Content="Одобрить заявку проекта" Command="{Binding ApproveSalaryProjectCommand}" Height="30" Background="#FFB2EBB2"/>
                                    </StackPanel>

                                    <!-- Список клиентов -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Все клиенты системы (Найм/Увольнение):" FontWeight="Bold"/>
                                        <ListView ItemsSource="{Binding AllClients}" SelectedItem="{Binding SelectedEmployee}" Height="150" Margin="0,5,0,10">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding Login}" Width="100"/>
                                                    <GridViewColumn Header="Компания" DisplayMemberBinding="{Binding DisplayCompanyName}" Width="200"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Устроить в выбранную комп." Command="{Binding AddEmployeeCommand}" Height="30" Width="170" Margin="0,0,10,0"/>
                                            <Button Content="Уволить" Command="{Binding RemoveEmployeeCommand}" Height="30" Width="100" Background="#FFFFC5C5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type viewmodels:ClientViewModel}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Личный кабинет Клиента" FontSize="20" FontWeight="Bold"/>
                            <Button Content="Выйти" Command="{Binding LogoutCommand}" HorizontalAlignment="Right" Width="80" Padding="5"/>
                        </Grid>

                        <!-- Вкладки Клиента -->
                        <TabControl Grid.Row="1">

                            <!-- Вкладка 1: Мои Счета -->
                            <TabItem Header="Мои счета и вклады">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Панель кнопок -->
                                    <WrapPanel Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
                                        <TextBlock Text="Выберите банк:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding AllBanks}" SelectedItem="{Binding SelectedBank}" DisplayMemberPath="Name" Width="150" Margin="0,0,10,0"/>
                                        <Button Content="Открыть счет" Command="{Binding OpenAccountCommand}" Padding="5" Margin="0,0,10,0"/>
                                        <Button Content="Открыть вклад (10%)" Command="{Binding OpenDepositCommand}" Padding="5"/>
                                    </WrapPanel>

                                    <!-- Таблица счетов -->
                                    <ListView Grid.Row="1" ItemsSource="{Binding MyAccounts}" SelectedItem="{Binding SelectedAccount}" Margin="0,0,0,10">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="ID" Width="280">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Id, Mode=OneWay}" 
                                                                IsReadOnly="True" 
                                                                BorderThickness="0" 
                                                                Background="Transparent" 
                                                                VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Баланс" DisplayMemberBinding="{Binding Balance}" Width="100"/>
                                                <GridViewColumn Header="Тип" DisplayMemberBinding="{Binding AccountType}" Width="150"/>
                                                <GridViewColumn Header="Заблокирован?" DisplayMemberBinding="{Binding IsBlocked}" Width="100"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <Button Grid.Row="2" Content="Закрыть выбранный счет (баланс должен быть 0)" Command="{Binding CloseAccountCommand}" Height="35" Width="300" HorizontalAlignment="Left" Background="#FFFFC5C5"/>
                                </Grid>
                            </TabItem>

                            <!-- Вкладка 2: Переводы -->
                            <TabItem Header="Переводы">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="350"/>
                                        <!-- Левая колонка для формы перевода -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Правая колонка для истории -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Форма перевода -->
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="Новый перевод" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                                        <TextBlock Text="Откуда (Ваш счет):"/>
                                        <ComboBox ItemsSource="{Binding MyAccounts}" SelectedItem="{Binding SelectedFromAccount}" DisplayMemberPath="Id" Margin="0,0,0,10"/>

                                        <TextBlock Text="Куда (ID счета получателя):"/>
                                        <TextBox Text="{Binding ToAccountId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                        <TextBlock Text="Сумма:"/>
                                        <TextBox Text="{Binding TransferAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                                        <Button Content="Выполнить перевод" Command="{Binding TransferCommand}" Height="35" Background="#FFB2EBB2" FontSize="14"/>
                                    </StackPanel>

                                    <!-- История операций -->
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Ваша история операций:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <ListView Grid.Row="1" ItemsSource="{Binding MyTransactions}">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Timestamp}" Width="130"/>
                                                    <GridViewColumn Header="Откуда" Width="200">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding FromAccountId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Куда" Width="200">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding ToAccountId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding Amount, StringFormat=\{0:F2\}}" Width="80"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <!-- Вкладка 3: Предприятия -->
                            <TabItem Header="Предприятия и Зарплата">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="350"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="Доступные предприятия:" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <ListView ItemsSource="{Binding AllCompanies}" SelectedItem="{Binding SelectedCompany}" Height="200" Margin="0,0,0,10">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                                    <GridViewColumn Header="Зарплата" DisplayMemberBinding="{Binding SalaryAmount, StringFormat=\{0:F2\}}" Width="90"/>
                                                    <GridViewColumn Header="ЗП Проект заявлен?" DisplayMemberBinding="{Binding IsSalaryProjectRequested}" Width="130"/>
                                                    <GridViewColumn Header="ЗП Проект одобрен?" DisplayMemberBinding="{Binding IsSalaryProjectApproved}" Width="130"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <Button Content="Подать заявку на ЗП проект от выбранного предприятия" Command="{Binding RequestSalaryProjectCommand}" Height="35"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Background="#FFF1F1F1" Margin="10" />
                                    <StackPanel Grid.Column="1" Margin="20">
                                        <TextBlock Text="Получение зарплаты" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                                        <TextBlock Text="Выберите ВАШ счет для зачисления:" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <ComboBox ItemsSource="{Binding MyAccounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Id" Margin="0,0,0,20"/>

                                        <Button Content="Получить зарплату" Command="{Binding ReceiveSalaryCommand}" Height="40" Background="#FFB2EBB2" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="(Доступно только если менеджер устроил вас в компанию с активным зарплатным проектом)" Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </DataTemplate>

            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>